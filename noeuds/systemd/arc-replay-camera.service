[Unit]
Description=Arc Replay - nœud caméra (publication RTSP vers le serveur)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/arc-replay-camera
ExecStart=/usr/bin/python3 /opt/arc-replay/camera/streamer.py \
    --serveur ${ARC_SERVEUR} --chemin ${ARC_CHEMIN} \
    --largeur ${ARC_LARGEUR} --hauteur ${ARC_HAUTEUR} --fps ${ARC_FPS} --debit ${ARC_DEBIT} \
    $ARC_OPTIONS
Restart=always
RestartSec=5
User=arc
SupplementaryGroups=video
# /var/lib/arc-replay : cadrage enregistré, restauré au démarrage
StateDirectory=arc-replay

[Install]
WantedBy=multi-user.target
