[Unit]
Description=Arc Replay - nœud cible (vue en direct, détection des impacts si activée)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/arc-replay/cible/cible.py --config /opt/arc-replay/cible/cible.yml
WorkingDirectory=/opt/arc-replay/cible
Restart=always
RestartSec=5
User=arc
SupplementaryGroups=video
# /var/lib/arc-replay : cadrage enregistré, restauré au démarrage
StateDirectory=arc-replay

[Install]
WantedBy=multi-user.target
