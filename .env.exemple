# Copier en .env et adapter.

# Fuseau horaire (noms des séances, heures dans le CSV)
TZ=Europe/Paris

# Port de l'interface web
ARC_PORT=80

# Port HTTPS : requis pour ajouter une caméra depuis un téléphone (voir /camera)
# ARC_PORT_HTTPS=443

# Images précompilées publiées par GitHub Actions (sinon : construction locale)
# ARC_REGISTRE=ghcr.io/<votre-compte-github>
# ARC_VERSION=latest

# Version de MediaMTX (garder une variante « -ffmpeg » pour les caméras USB)
# MEDIAMTX_TAG=1.21.2-ffmpeg

# Détecteur de lâcher (profil « audio »)
# SEUIL_DB=-20
# PERIPHERIQUE_AUDIO=
